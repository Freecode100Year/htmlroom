{
  "name": "htmlroom",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [{ "name": "JOIN_LIMIT", "namespace_id": "8965", "simple": { "limit": 60, "period": 60 } }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false }
}
