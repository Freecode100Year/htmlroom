{
  "name": "htmlroom",
  "version": "1.0.0",
  "description": "Standalone encrypted HTML chat rooms with Node and Cloudflare relays",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "build": "node scripts/build-html-room.mjs template",
    "build:pages": "node scripts/build-html-room.mjs pages",
    "build:check": "node scripts/build-html-room.mjs template --check",
    "test": "node --test",
    "test:browser": "node browser-tests/htmlroom.mjs && node browser-tests/html-room-preview.mjs && node browser-tests/multi-relay.mjs",
    "test:failover": "node browser-tests/multi-relay.mjs",
    "test:pages": "npm run build:pages && node browser-tests/pages.mjs",
    "test:preview": "node browser-tests/html-room-preview.mjs",
    "test:worker": "HR_WORKER_TEST=1 node --test test/hr-worker.test.mjs",
    "html-room:generate": "node scripts/build-html-room.mjs",
    "html-room:check": "node scripts/check-html-room.mjs",
    "deploy": "npm run build:check && wrangler deploy"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freecode100Year/htmlroom.git"
  },
  "homepage": "https://github.com/Freecode100Year/htmlroom",
  "bugs": {
    "url": "https://github.com/Freecode100Year/htmlroom/issues"
  }
}
